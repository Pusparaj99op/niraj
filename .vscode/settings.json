{
  "folders": [
    {
      "name": "NIRAJ Root",
      "path": "."
    },
    {
      "name": "Backend",
      "path": "./backend"
    },
    {
      "name": "Frontend",
      "path": "./frontend"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "./backend/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.linting.enabled": true,
    "python.linting.flake8Enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.mypyEnabled": true,
    "python.linting.banditEnabled": true,
    "python.linting.pycodestyleEnabled": true,
    "python.linting.pydocstyleEnabled": true,
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always",
      "source.fixAll.eslint": "always",
      "source.fixAll": "always"
    },
    "files.associations": {
      "*.yaml": "yaml",
      "*.yml": "yaml"
    },
    "typescript.preferences.includePackageJsonAutoImports": "auto",
    "eslint.enable": false,
    "eslint.workingDirectories": ["frontend"],
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "typescript",
      "typescriptreact"
    ],
    "tailwindCSS.includeLanguages": {
      "typescript": "javascript",
      "typescriptreact": "javascript"
    },
    "yaml.validate": true,
    "yaml.format.enable": true,
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    "html.validate.scripts": false,
    "html.validate.styles": false,
    "css.lint.validProperties": [],
    "css.lint.unknownProperties": "ignore",
    "css.lint.vendorPrefix": "ignore",
    "css.lint.compatibleVendorPrefixes": "ignore",
    "typescript.validate.enable": false,
    "javascript.validate.enable": false,
    "problems.showCurrentInStatus": true,
    "problems.showErrors": true,
    "problems.showWarnings": true,
    "problems.showInformations": true,
    "problems.showHints": true
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.flake8",
      "ms-python.black-formatter",
      "ms-python.isort",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "formulahendry.auto-rename-tag",
      "christian-kohler.path-intellisense",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "NIRAJ Backend",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/backend/src/main.py",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/backend/.env",
        "cwd": "${workspaceFolder}/backend"
      },
      {
        "name": "NIRAJ Frontend Dev",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}/frontend"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Backend: Install Dependencies",
        "type": "shell",
        "command": "poetry install",
        "options": {
          "cwd": "${workspaceFolder}/backend"
        },
        "group": "build"
      },
      {
        "label": "Frontend: Install Dependencies",
        "type": "shell",
        "command": "npm install",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "group": "build"
      },
      {
        "label": "Backend: Run Development Server",
        "type": "shell",
        "command": "poetry run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
        "options": {
          "cwd": "${workspaceFolder}/backend"
        },
        "group": "test",
        "isBackground": true
      },
      {
        "label": "Frontend: Run Development Server",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder}/frontend"
        },
        "group": "test",
        "isBackground": true
      },
      {
        "label": "Run Both Servers",
        "dependsOrder": "parallel",
        "dependsOn": [
          "Backend: Run Development Server",
          "Frontend: Run Development Server"
        ],
        "group": "test"
      }
    ]
  },
  "chat.tools.terminal.autoApprove": {
    "bash": true,
    "zsh": true,
    "sh": true,
    "*" : true,
    "powershell": true,
    "cmd": true,
    "python": true,
    "npm": true,
    "yarn": true,
    "poetry": true,
    "pip": true,
    "git": true,
    "code": true,
    "vim": true,
    "nano": true,
    "emacs": true,
    "make": true,
    "cargo": true,
    "rustc": true,
    "go": true,
    "java": true,
    "javac": true,
    "dotnet": true,
    "docker": true,
    "kubectl": true,
    "helm": true,
    "terraform": true,
    "ssh": true,
    "scp": true,
    "rsync": true,
    "tar": true,
    "zip": true,
    "unzip": true,
    "gzip": true,
    "gunzip": true,
    "ping": true,
    "systemctl": true,
    "service": true,
    "crontab": true,
    "mount": true,
    "umount": true,
    "fdisk": true,
    "lsblk": true,
    "free": true,
    "uptime": true,
    "whoami": true,
    "id": true,
    "groups": true,
    "history": true,
    "alias": true,
    "export": true,
    "source": true,
    "sudo": true,
    "su": true,
    "env": true,
    "printenv": true,
    "set": true,
    "unset": true,
    "clear": true,
    "reset": true,
    "exit": true,
    "logout": true,
    "uname": true,
    "lscpu": true,
    "lsusb": true,
    "lspci": true,
    "dmesg": true,
    "journalctl": true,
    "lsof": true,
    "netstat": true,
    "ss": true,
    "iptables": true,
    "firewall-cmd": true,
    "ufw": true,
    "man": true,
    "info": true,
    "help": true,
    "apropos": true,
    "whereis": true,
    "locate": true,
    "updatedb": true,
    "ln": true,
    "cp": true,
    "mv": true,
    "mkdir": true,
    "touch": true,
    "diff": true,
    "patch": true,
    "awk": true,
    "sed": true,
    "perl": true,
    "ruby": true,
    "php": true,
    "python3": true,
    "node": true,
    "deno": true,
    "bun": true,
    "cd": true,
    "echo": true,
    "ls": true,
    "pwd": true,
    "cat": true,
    "head": true,
    "tail": true,
    "findstr": true,
    "wc": true,
    "tr": true,
    "cut": true,
    "cmp": true,
    "which": true,
    "basename": true,
    "dirname": true,
    "realpath": true,
    "readlink": true,
    "stat": true,
    "file": true,
    "du": true,
    "df": true,
    "sleep": true,
    "git status": true,
    "git log": true,
    "git show": true,
    "git diff": true,
    "Get-ChildItem": true,
    "Get-Content": true,
    "Get-Date": true,
    "Get-Random": true,
    "Get-Location": true,
    "Write-Host": true,
    "Write-Output": true,
    "Split-Path": true,
    "Join-Path": true,
    "Start-Sleep": true,
    "Where-Object": true,
    "/^Select-[a-z0-9]/i": true,
    "/^Measure-[a-z0-9]/i": true,
    "/^Compare-[a-z0-9]/i": true,
    "/^Format-[a-z0-9]/i": true,
    "/^Sort-[a-z0-9]/i": true,
    "column": true,
    "/^column\\b.*-c\\s+[0-9]{4,}/": false,
    "date": true,
    "/^date\\b.*(-s|--set)\\b/": false,
    "find": true,
    "/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
    "grep": true,
    "/^grep\\b.*-(f|P)\\b/": false,
    "sort": true,
    "/^sort\\b.*-(o|S)\\b/": false,
    "tree": true,
    "/^tree\\b.*-o\\b/": false,
    "/\\(.+\\)/": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\{.+\\}/": {
      "approve": false,
      "matchCommandLine": true
    },
    "/`.+`/": {
      "approve": false,
      "matchCommandLine": true
    },
    "rm": false,
    "rmdir": false,
    "del": false,
    "Remove-Item": false,
    "ri": false,
    "rd": false,
    "erase": false,
    "dd": false,
    "kill": false,
    "ps": false,
    "top": false,
    "Stop-Process": false,
    "spps": false,
    "taskkill": false,
    "taskkill.exe": false,
    "curl": false,
    "wget": false,
    "Invoke-RestMethod": false,
    "Invoke-WebRequest": false,
    "irm": false,
    "iwr": false,
    "chmod": false,
    "chown": false,
    "Set-ItemProperty": false,
    "sp": false,
    "Set-Acl": false,
    "jq": false,
    "xargs": false,
    "eval": false,
    "Invoke-Expression": false,
    "iex": false
  },
  "files.autoSave": "afterDelay",
  "python.analysis.typeCheckingMode": "standard"
}
